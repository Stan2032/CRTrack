{
  "name": "crtrack",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Keep variables set in the Cloudflare dashboard (e.g. ALLOWED_CLANS) when deploying.
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
