{
  "name": "crtrack",
  "main": "worker/index.js",
  // Copies site/logic.js and site/stats.js into modules for the Worker (the bot decides like the page).
  "build": { "command": "node worker/gen.mjs" },
  "compatibility_date": "2025-09-01",
  // Keep variables set in the Cloudflare dashboard (e.g. ALLOWED_CLANS) when deploying.
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // History store. Snapshots of members and the current race every 15 minutes.
  "d1_databases": [
    { "binding": "DB", "database_name": "crtrack-history", "database_id": "513fad6e-908f-4a83-b3c4-b142df48b364" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Worker logs (Cloudflare dashboard → Workers → crtrack → Logs): errors and what each run did, kept a few days.
  "observability": { "enabled": true }
}
